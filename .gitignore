node_modules/

# Scraped listing data — personal, noisy, and can get large.
# searches.json IS tracked (it's your editable config).
data/*.json
data/*.sqlite
data/*.db
!data/.gitkeep

# Raw browse batches are personal too. Fixtures are the exception: they carry no
# real listings and are what lets scoring be tested without touching Facebook.
data/incoming/*.json
!data/incoming/fixture-*.json

# Local run state
.runstate/
*.log
.DS_Store

# Secrets — Supabase service role key and dashboard password.
.env.local
.env

# web/index.html and web/api/_lib/{score,fairvalue,supabase}.mjs are generated
# by scripts/sync-web.mjs but ARE committed: Vercel builds straight from git,
# so the deploy tree has to be complete in the repo. Edit the canonical copies
# (dashboard/, scripts/lib/) and re-run the sync before committing.
